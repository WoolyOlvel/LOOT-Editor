#4: (Fin, Delete, _)

#Tokenización de texto.

#1: (Funcion, Split, _)
#2: (return, (, _))
#3: (print, (, _))
#4: (Fin, Split, _)

#Remoción de caracteres especiales

#1: (Funcion, Especial, _)
